{
    "name": "special-callouts",
    "version": "1.0.8",
    "description": "Advanced callout styling plugin for Obsidian",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "typecheck": "tsc --noEmit",
        "build": "tsc --noEmit && node esbuild.config.mjs production",
        "test": "node --test \"tests/**/*.test.mjs\"",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [
        "obsidian",
        "callout",
        "styling",
        "layout",
        "grid"
    ],
    "author": "ahseyg",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^16.11.6",
        "esbuild": "0.25.5",
        "tslib": "2.4.0",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "obsidian": "latest"
    }
}
